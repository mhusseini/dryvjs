{
  "name": "@softwareproduction/dryvue",
  "version": "2.1.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Munir Husseini (https://github.com/mhusseini)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhusseini/dryvjs",
    "directory": "packages/dryvue"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "vitest run && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@softwareproduction/dryvjs": "^1.1.0"
  },
  "peerDependencies": {
    "vue": "^3.5.15"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.18.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.49.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.0.3",
    "tsup": "^8.4.0",
    "typescript": "~5.2.0",
    "vitest": "^3.2.1",
    "vue": "^3.5.15"
  }
}
