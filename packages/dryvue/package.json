{
  "name": "@softwareproduction/dryvue",
  "version": "2.0.1-pre.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "license": "MIT",
  "author": "Munir Husseini (https://github.com/mhusseini)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhusseini/dryvjs",
    "directory": "packages/dryvue"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "dev": "tsc --skipLibCheck && (concurrently \"tsc --skipLibCheck -w\" \"tsc-alias -w\")",
    "build": "tsc --skipLibCheck  && tsc-alias",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@softwareproduction/dryvjs": "^1.0.1-pre.0"
  },
  "peerDependencies": {
    "vue": "^3.5.15"
  },
  "devDependencies": {
    "vue": "^3.5.15",
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.18.5",
    "concurrently": "^8.2.2",
    "eslint": "^8.49.0",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "tsc-alias": "^1.8.8",
    "typescript": "~5.2.0"
  }
}
