{
  "name": "@softwareproduction/dryvjs",
  "version": "1.0.1-pre.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Munir Husseini (https://github.com/mhusseini)",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhusseini/dryvjs",
    "directory": "packages/dryvjs"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.18.5",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3",
    "tsup": "^8.4.0",
    "typescript": "~5.2.0"
  }
}
